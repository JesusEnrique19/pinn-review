.venv/
__pycache__/
*.pyc
.pytest_cache/

# Raw API dumps are regenerated from the frozen snapshot manifest; large files go to Zenodo
data/raw/
data/cache/
# Abstracts and embeddings derived from raw dumps: publisher abstracts are not redistributed
data/interim/

# Word lock files; the original proposal and journal template stay local (private drafts)
~$*.docx
/*.docx

# benchmark smoke tests
results/bench/*_smoke.json

# manuscript build outputs (regenerated by python -m pinnreview.manuscript)
paper/build/

# public release copy (scripts/make_public_release.py)
release/
